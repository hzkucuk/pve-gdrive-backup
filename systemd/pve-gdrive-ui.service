[Unit]
Description=Proxmox -> Google Drive yedek web arayuzu
After=network-online.target
Wants=network-online.target

# Birim coktugunde haber ver (bkz. pve-gdrive-bildir@.service).
# Arac kendini izlemiyordu: servis olurse yedek alinmadigi ancak
# haftalik raporda -o da gidebilirse- fark ediliyordu.
OnFailure=pve-gdrive-bildir@%n.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/pve_gdrive.py serve
Restart=always
RestartSec=5

# --- Kaynak denetimi: arayuz hafif kalmali ---
Nice=5
CPUWeight=30
MemoryMax=512M
MemoryHigh=256M
TasksMax=128

# --- Sertlestirme ---
NoNewPrivileges=yes
# ProtectHome=yes KULLANILMAZ: rclone yapilandirmasi /root altinda yasar ve
# bu ayar servisin onu gormesini engelliyordu -> "remote bulunamadi" ile sessiz
# basarisizlik. Bunun yerine config /root disina alinir ve ev dizini gizlenir.
ProtectHome=tmpfs
Environment=RCLONE_CONFIG=/var/lib/pve-gdrive/rclone.conf
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
