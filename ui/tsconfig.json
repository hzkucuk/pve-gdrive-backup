{
  "compilerOptions": {
    "target": "ES2019",
    "module": "none",
    "lib": ["ES2019", "DOM", "DOM.Iterable"],
    "outFile": "dist/app.js",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,
    "removeComments": false,
    "sourceMap": false
  },
  "files": ["src/types.ts", "src/en.ts", "src/dil.ts", "src/app.ts", "src/alanlar.ts"]
}
