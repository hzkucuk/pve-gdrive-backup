[Unit]
Description=Proxmox -> Google Drive yedek web arayuzu
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/bin/pve_gdrive.py serve
Restart=always
RestartSec=5

# --- Kaynak denetimi: arayuz hafif kalmali ---
Nice=5
CPUWeight=30
MemoryMax=512M
MemoryHigh=256M
TasksMax=128

# --- Sertlestirme ---
NoNewPrivileges=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
